{
    "private": true,
    "repository": "github:noeldemartin/media-kraken",
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:storybook": "storybook build",
        "dev": "vp dev",
        "dev:serve-pod": "community-solid-server -c @css:config/file.json -f ./solid",
        "deploy": "noeldemartin-deploy-app",
        "e2e:dev": "concurrently --kill-others \"vp run e2e:serve-app\" \"vp run e2e:serve-pod\" \"vp run e2e:open\"",
        "e2e:open": "UI=true playwright test --ui",
        "e2e:run": "playwright test",
        "e2e:serve-app": "vp dev --port 5001 --mode testing",
        "e2e:serve-pod": "community-solid-server -l warn",
        "e2e:test:chromium": "start-server-and-test e2e:serve-app http-get://localhost:5001 e2e:serve-pod http-get://localhost:3000 'vp run e2e:run --project=chromium'",
        "e2e:test:firefox": "start-server-and-test e2e:serve-app http-get://localhost:5001 e2e:serve-pod http-get://localhost:3000 'vp run e2e:run --project=firefox'",
        "e2e:test:webkit": "start-server-and-test e2e:serve-app http-get://localhost:5001 e2e:serve-pod http-get://localhost:3000 'vp run e2e:run --project=webkit'",
        "type-check": "vue-tsc --build --force",
        "storybook": "storybook dev -p 6006"
    },
    "dependencies": {
        "@aerogel/core": "next",
        "@aerogel/plugin-i18n": "next",
        "@aerogel/plugin-local-first": "next",
        "@aerogel/plugin-routing": "next",
        "@aerogel/plugin-solid": "next",
        "@noeldemartin/solid-utils": "catalog:",
        "@noeldemartin/utils": "catalog:",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.16",
        "papaparse": "^5.7.0",
        "soukai-bis": "catalog:",
        "tailwindcss": "^4.1.1",
        "vue": "^3.5.13",
        "vue-i18n": "^11.1.2",
        "vue-router": "^4.5.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@aerogel/cli": "next",
        "@aerogel/playwright": "next",
        "@aerogel/storybook": "next",
        "@aerogel/vite": "next",
        "@iconify/json": "2.2.522",
        "@noeldemartin/scripts": "next",
        "@noeldemartin/testing": "next",
        "@noeldemartin/vite-plus-config": "next",
        "@playwright/test": "^1.60.0",
        "@solid/community-server": "7.1.6",
        "@storybook/addon-docs": "^10.5.7",
        "@storybook/vue3-vite": "^10.5.4",
        "@total-typescript/ts-reset": "^0.4.2",
        "@tsconfig/node26": "^26.0.1",
        "@types/node": "^26.6.3",
        "@types/papaparse": "^5.5.2",
        "@vue/tsconfig": "^0.9.1",
        "concurrently": "^10.0.3",
        "start-server-and-test": "^3.0.8",
        "storybook": "^10.5.4",
        "typescript": "~6.0.2",
        "vite": "catalog:",
        "vite-plugin-multi-root-workspace": "next",
        "vite-plus": "catalog:",
        "vue-tsc": "^3.2.7"
    },
    "packageManager": "pnpm@12.8.1"
}
