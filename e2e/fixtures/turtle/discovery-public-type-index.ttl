@prefix solid: <http://www.w3.org/ns/solid/terms#> .
@prefix schema: <https://schema.org/> .

<> a solid:TypeIndex, solid:ListedDocument .

<#favorites>
    a solid:TypeRegistration ;
    solid:forClass schema:ItemList ;
    solid:instance <../lists/favorites#it> .

<#groceries>
    a solid:TypeRegistration ;
    solid:forClass schema:ItemList ;
    solid:instance <../lists/groceries#it> .

<../lists/favorites#it> schema:about schema:Movie, schema:TVSeries .
