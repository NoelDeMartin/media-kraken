INSERT DATA {
    @prefix schema: <https://schema.org/> .
    @prefix crdt: <https://vocab.noeldemartin.com/crdt/> .
    @prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

    <#it>
        a schema:Movie ;
        schema:name "{{ name }}" ;
        schema:description "[[.*]]" ;
        schema:image <[[.*]]> ;
        schema:datePublished "[[.*]]"^^xsd:dateTime ;
        schema:sameAs <https://www.themoviedb.org/movie/[[.*]]>, <https://www.imdb.com/title/[[.*]]/> ;
        schema:genre <https://www.themoviedb.org/genre/28>, <https://www.themoviedb.org/genre/878> ;
        schema:countryOfOrigin <http://www.wikidata.org/entity/Q30> ;
        schema:inLanguage "en" ;
        schema:duration "PT2H16M" ;
        schema:director <#[[director-1][%uuid%]]>, <#[[director-2][%uuid%]]> ;
        schema:actor <#[[actor-1][%uuid%]]>, <#[[actor-2][%uuid%]]>, <#[[actor-3][%uuid%]]>, <#[[actor-4][%uuid%]]>, <#[[actor-5][%uuid%]]>, <#[[actor-6][%uuid%]]> .

    <#it-metadata>
        a crdt:Metadata ;
        crdt:resource <#it> ;
        crdt:createdAt "[[createdAt][.*]]"^^xsd:dateTime ;
        crdt:updatedAt "[[createdAt][.*]]"^^xsd:dateTime .

    <#[[director-1][%uuid%]]>
        a schema:Person ;
        schema:name "Lana Wachowski" ;
