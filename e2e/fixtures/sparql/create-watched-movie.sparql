INSERT DATA {
    @prefix schema: <https://schema.org/> .
    @prefix crdt: <https://vocab.noeldemartin.com/crdt/> .
    @prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

    <#it>
        a schema:Movie ;
        schema:name "{{ name }}" ;
        schema:description "[[.*]]" ;
        schema:image <[[.*]]> ;
        schema:datePublished "[[.*]]"^^xsd:dateTime ;
        schema:sameAs <https://www.themoviedb.org/movie/[[.*]]>, <https://www.imdb.com/title/[[.*]]/> .

    <#it-metadata>
        a crdt:Metadata ;
        crdt:resource <#it> ;
        crdt:createdAt "[[createdAt][.*]]"^^xsd:dateTime ;
        crdt:updatedAt "[[createdAt][.*]]"^^xsd:dateTime .

    <#[[watch-action][%uuid%]]>
        a schema:WatchAction ;
        schema:object <#it> ;
        schema:endTime "[[watchedAt][.*]]"^^xsd:dateTime .

    <#[[watch-action][%uuid%]]-metadata>
        a crdt:Metadata ;
        crdt:resource <#[[watch-action][%uuid%]]> ;
        crdt:createdAt "[[createdAt][.*]]"^^xsd:dateTime ;
        crdt:updatedAt "[[createdAt][.*]]"^^xsd:dateTime .
}
