    <#[[actor-3][%uuid%]]-tombstone>
        a crdt:Tombstone ;
        crdt:resource <#[[actor-3][%uuid%]]> ;
        crdt:deletedAt "[[.*]]"^^xsd:dateTime .

    <#[[role-4][%uuid%]]-tombstone>
        a crdt:Tombstone ;
        crdt:resource <#[[role-4][%uuid%]]> ;
        crdt:deletedAt "[[.*]]"^^xsd:dateTime .

    <#[[actor-4][%uuid%]]-tombstone>
        a crdt:Tombstone ;
        crdt:resource <#[[actor-4][%uuid%]]> ;
        crdt:deletedAt "[[.*]]"^^xsd:dateTime .

    <#[[role-5][%uuid%]]-tombstone>
        a crdt:Tombstone ;
        crdt:resource <#[[role-5][%uuid%]]> ;
        crdt:deletedAt "[[.*]]"^^xsd:dateTime .

    <#[[actor-5][%uuid%]]-tombstone>
        a crdt:Tombstone ;
        crdt:resource <#[[actor-5][%uuid%]]> ;
        crdt:deletedAt "[[.*]]"^^xsd:dateTime .

    <#[[role-6][%uuid%]]-tombstone>
        a crdt:Tombstone ;
        crdt:resource <#[[role-6][%uuid%]]> ;
        crdt:deletedAt "[[.*]]"^^xsd:dateTime .

    <#[[actor-6][%uuid%]]-tombstone>
        a crdt:Tombstone ;
        crdt:resource <#[[actor-6][%uuid%]]> ;
        crdt:deletedAt "[[.*]]"^^xsd:dateTime .

    <#[[watch-action][%uuid%]]-tombstone>
        a crdt:Tombstone ;
        crdt:resource <#[[watch-action][%uuid%]]> ;
        crdt:deletedAt "[[.*]]"^^xsd:dateTime .
}
