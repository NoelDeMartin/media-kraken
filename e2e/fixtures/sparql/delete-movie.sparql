    <#[[actor-1][%uuid%]]-tombstone>
        a crdt:Tombstone ;
        crdt:resource <#[[actor-1][%uuid%]]> ;
        crdt:deletedAt "[[.*]]"^^xsd:dateTime .

    <#[[role-2][%uuid%]]-tombstone>
